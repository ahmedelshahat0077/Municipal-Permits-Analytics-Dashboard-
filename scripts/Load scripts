/*
===============================================================================
load Script: loading municipality analysis dataset Tables
===============================================================================
Script Purpose:
    This script loads data into tables from external CSV files. 
    It performs the following actions:
    - Truncates the tables before loading data.
    - Uses the `BULK INSERT` command to load data from csv Files to tables.
	===============================================================================
*/
--------------------------------------------------------------
-- inserting data into table fact_permits
--------------------------------------------------------------
PRINT '>> trucating table: fact_permits';
truncate table fact_permits
PRINT '>> Inserting Data Into: fact_permits';
BULK INSERT fact_permits
FROM 'D:\SQL\municiplity project\fact_permits.csv'
		with
		(
		firstrow = 2,
		fieldterminator = ',',
		ROWTERMINATOR = '0x0a',
		tablock
		);
		go
-------------------------------------------------------------------------
--------------------------------------------------------------
